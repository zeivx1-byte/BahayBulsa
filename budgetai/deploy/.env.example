# Copy to deploy/.env on the server and fill in the required values.
# Use the published ghcr.io image reference, preferably an immutable digest.
BUDGETAI_IMAGE=
# Use the DNS hostname without a scheme, port or path.
BUDGETAI_DOMAIN=
BUDGETAI_USERNAME=budgetai
# Generate interactively with: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep single quotes around the bcrypt hash so Compose preserves its dollar signs.
BUDGETAI_PASSWORD_HASH=''
# Downloaded by Ollama into the named volume on the server.
BUDGETAI_MODEL=qwen3.5:2b-q4_K_M
