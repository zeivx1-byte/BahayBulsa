# Template for the .env file. This copy IS saved in Git (it contains no secrets).
# On a new computer, copy this file, rename the copy to ".env",
# then adjust the values for that machine.

BUDGETAI_PROVIDER=groq
GROQ_API_KEY=
BUDGETAI_MODEL=openai/gpt-oss-20b
BUDGETAI_CURRENCY=PHP
BUDGETAI_TEMPERATURE=0
BUDGETAI_TIMEOUT_SECONDS=30
