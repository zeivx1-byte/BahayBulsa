{
  "name": "BahayBulsa browser preview",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "BahayBulsa preview"
    },
    "11434": {
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "python -m venv budgetai/.venv && budgetai/.venv/bin/python -m pip install -r budgetai/requirements.txt",
  "postStartCommand": ["bash", ".devcontainer/start-preview.sh"],
  "waitFor": "postStartCommand"
}
